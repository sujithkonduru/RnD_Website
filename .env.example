# Canonical origin used for metadata, canonical URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://stackenzo.com

# Contact form delivery (Resend). Without these the API returns a 503 and the
# form surfaces that message to the user instead of pretending to succeed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
